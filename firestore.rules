rules_version = '2';

// Rules for the shared Bible text: everybody reads, everybody who opened the site may write (anonymous sign-in),
// but only well-formed chapters, and nothing can be deleted — every saved version stays in the chapter's history.
//
// To freeze editing in an emergency: in the Firebase console open Firestore Database, create the document
// meta/lock with the boolean field  on = true.  Delete the document (or set on = false) to open editing again.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function writable() {
      return !(exists(/databases/$(database)/documents/meta/lock)
               && get(/databases/$(database)/documents/meta/lock).data.on == true);
    }

    // every write carries the server time, the writer's id and an optional display name
    function stamped() {
      let d = request.resource.data;
      return d.t == request.time
          && d.u == request.auth.uid
          && d.by is string && d.by.size() <= 40;
    }

    // "19_23" = book 19, chapter 23
    function chapterId(id) {
      return id.matches('^[0-9]{1,2}_[0-9]{1,3}$')
          && int(id.split('_')[0]) >= 1 && int(id.split('_')[0]) <= 66
          && int(id.split('_')[1]) >= 1 && int(id.split('_')[1]) <= 150;
    }

    // v = the verses of the chapter, or null for "back to the original text"
    function chapterData() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 't', 'by', 'u'])
          && d.keys().hasAll(['v', 't', 'by', 'u'])
          && stamped()
          && (d.v == null
              || (d.v is list && d.v.size() >= 1 && d.v.size() <= 200
                  && d.v[0] is string && d.v[d.v.size() - 1] is string));
    }

    function siteData() {
      let d = request.resource.data;
      return d.keys().hasOnly(['bookNames', 't', 'by', 'u'])
          && d.keys().hasAll(['bookNames', 't', 'by', 'u'])
          && stamped()
          && d.bookNames is map && d.bookNames.size() <= 66;
    }

    match /chapters/{id} {
      allow read: if true;
      allow create, update: if signedIn() && writable() && chapterId(id) && chapterData();
      allow delete: if false;

      match /history/{entry} {
        allow read: if true;
        allow create: if signedIn() && writable() && chapterId(id) && chapterData();
        allow update, delete: if false;
      }
    }

    match /meta/site {
      allow read: if true;
      allow create, update: if signedIn() && writable() && siteData();
      allow delete: if false;

      match /history/{entry} {
        allow read: if true;
        allow create: if signedIn() && writable() && siteData();
        allow update, delete: if false;
      }
    }

    // the freeze switch: readable by the page (to show a notice), changed only in the console
    match /meta/lock {
      allow read: if true;
      allow write: if false;
    }
  }
}
